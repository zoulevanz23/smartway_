# Groq API key (free tier, llama-3.3-70b-versatile)
# Get yours free at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Supabase (for file upload support)
# Create a project, make a PUBLIC bucket, get these from
# Project Settings -> API in the Supabase dashboard
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: override the default storage bucket name (defaults to "uploads")
VITE_SUPABASE_BUCKET=uploads
